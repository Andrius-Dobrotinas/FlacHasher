<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>disable</Nullable>
    <RootNamespace>Andy.ExternalProcess</RootNamespace>
    <AssemblyName>ExternalProcess.Lib</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The fake-process entry point isn't part of the contract, but the handful of tests that need a fake process can't be written without it -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ExternalProcess.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
