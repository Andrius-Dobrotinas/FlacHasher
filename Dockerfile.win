FROM mcr.microsoft.com/dotnet/sdk:8.0-nanoserver-ltsc2022 AS tests

FROM tests AS tests-e2e

# Install FLAC
RUN mkdir c:\decoder
RUN curl --location --output c:\decoder\flac.zip https://ftp.osuosl.org/pub/xiph/releases/flac/flac-1.5.0-win.zip
RUN tar --extract --file c:\decoder\flac.zip --directory c:\decoder
RUN del c:\decoder\flac.zip

ENV FLACHASH_TEST_DECODER=c:\\decoder\\flac-1.5.0-win\\Win64\\flac.exe

# 7-Zip (standalone console build) -- needed to unpack the Monkey's Audio installer without running it:
# nanoserver has no GUI subsystem (user32/gdi32) for a regular installer executable to launch against.
RUN mkdir c:\tools
RUN curl --location --output c:\tools\7za.zip https://www.7-zip.org/a/7za920.zip
RUN tar --extract --file c:\tools\7za.zip --directory c:\tools
RUN del c:\tools\7za.zip

# Install Monkey's Audio (APE decoder): unpack MAC.exe straight out of the installer with 7-Zip instead of running it
# MAC.exe is assumed to be in the root dir of the installer
RUN mkdir c:\decoder\ape-setup
RUN curl --location --output c:\decoder\ape-setup\setup.exe https://monkeysaudio.com/x64
RUN c:\tools\7za.exe x c:\decoder\ape-setup\setup.exe -oc:\decoder\ape-setup\extracted -y
RUN copy c:\decoder\ape-setup\extracted\MAC.exe c:\decoder\MACs.exe
RUN rmdir /s /q c:\decoder\ape-setup

ENV FLACHASH_TEST_DECODER_APE=c:\\decoder\\MAC.exe
